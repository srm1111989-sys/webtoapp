<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen incoming-request screen (Phase 2). Inflated by IncomingRequestActivity.
     Same field IDs as the floating overlay so the populate code is shared in spirit:
     iv_logo, tv_countdown, tv_service_type, tv_customer, tv_price, tv_area,
     tv_description, btn_accept, btn_reject, btn_negotiate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="24dp"
    android:layoutDirection="locale"
    android:textAlignment="viewStart">

    <!-- Header: logo + countdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="24dp">
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="logo" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView
            android:id="@+id/tv_countdown"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FBBF24" android:textSize="30sp" android:textStyle="bold"
            android:text="30" />
    </LinearLayout>

    <!-- Spacer -->
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.4" />

    <!-- Details -->
    <TextView
        android:id="@+id/tv_service_type"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#F8FAFC" android:textSize="26sp" android:textStyle="bold" />
    <TextView
        android:id="@+id/tv_customer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:textColor="#E2E8F0" android:textSize="18sp" />
    <TextView
        android:id="@+id/tv_price"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="#4ADE80" android:textSize="22sp" android:textStyle="bold" />
    <TextView
        android:id="@+id/tv_area"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="#94A3B8" android:textSize="16sp" />
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:textColor="#CBD5E1" android:textSize="16sp" />

    <!-- Spacer -->
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="24dp">
        <Button android:id="@+id/btn_accept"
            android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:text="Accept" />
        <Button android:id="@+id/btn_reject"
            android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:text="Reject" />
        <Button android:id="@+id/btn_negotiate"
            android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1"
            android:text="Negotiate" />
    </LinearLayout>
</LinearLayout>
