<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming-request floating overlay layout. Inflated by FloatingOverlayService.
     Field IDs are looked up by name; keep them stable: tv_service_type, tv_customer,
     tv_price, tv_area, tv_description, tv_countdown, btn_accept, btn_reject, btn_negotiate.
     layoutDirection=locale so Arabic content lays out right-to-left naturally. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EE1E293B"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:layoutDirection="locale"
    android:textAlignment="viewStart"
    android:elevation="12dp">

    <!-- Top row: app logo (start) + countdown (end) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="logo" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/tv_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FBBF24"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="30" />
    </LinearLayout>

    <!-- Row 1: Customer name | Service type -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">
        <TextView
            android:id="@+id/tv_customer"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#E2E8F0" android:textSize="14sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_service_type"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end"
            android:textColor="#F1F5F9" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: Area | Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">
        <TextView
            android:id="@+id/tv_area"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#94A3B8" android:textSize="13sp" />
        <TextView
            android:id="@+id/tv_price"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end"
            android:textColor="#4ADE80" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 3: Order description -->
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="#CBD5E1" android:textSize="13sp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp">
        <Button android:id="@+id/btn_accept"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:text="Accept" />
        <Button android:id="@+id/btn_reject"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:text="Reject" />
        <Button android:id="@+id/btn_negotiate"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Negotiate" />
    </LinearLayout>
</LinearLayout>
