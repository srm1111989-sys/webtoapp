<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming-request floating overlay layout. Inflated by FloatingOverlayService.
     Field IDs are looked up by name; keep them stable: tv_service_type, tv_customer,
     tv_price, tv_area, tv_description, tv_status, tv_countdown, btn_accept,
     btn_reject, btn_negotiate.
     layoutDirection=locale so Arabic content lays out right-to-left naturally.
     Colors come from colors_incoming.xml (+ values-night twin) so the card follows
     the device dark/light mode like the full-screen view; buttons use plain shape
     drawables because a WindowManager-inflated view has no Material theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_incoming_card"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:layoutDirection="locale"
    android:textAlignment="viewStart"
    android:elevation="12dp">

    <!-- Top row: app logo (start) + countdown (end) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="logo" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/tv_countdown"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="@drawable/bg_incoming_countdown"
            android:textColor="@color/incoming_countdown_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="30" />
    </LinearLayout>

    <!-- Row 1: Customer name | Service type -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">
        <TextView
            android:id="@+id/tv_customer"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/incoming_text_secondary" android:textSize="14sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_service_type"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/incoming_text" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: Area | Price -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">
        <TextView
            android:id="@+id/tv_area"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/incoming_text_muted" android:textSize="13sp" />
        <TextView
            android:id="@+id/tv_price"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/incoming_price" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 3: Order description -->
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textColor="@color/incoming_text_secondary" android:textSize="13sp" />

    <!-- Action feedback (accepting… / backend error) -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="@color/incoming_status" android:textSize="13sp" android:textStyle="bold" />

    <!-- Actions: Reject red outline · Negotiate blue outline · Accept solid green -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp">
        <Button android:id="@+id/btn_reject"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_outline_red"
            android:textColor="@color/incoming_reject"
            android:textSize="13sp"
            android:text="Reject" />
        <Button android:id="@+id/btn_negotiate"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_outline_blue"
            android:textColor="@color/incoming_negotiate"
            android:textSize="13sp"
            android:text="عرض التفاصيل" />
        <Button android:id="@+id/btn_accept"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1.15"
            android:background="@drawable/bg_btn_accept"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:text="Accept" />
    </LinearLayout>
</LinearLayout>
