    <color name="incoming_text_muted">#64748B</color>
    <color name="incoming_price">#15803D</color>
    <color name="incoming_countdown_bg">#FEF3C7</color>
    <color name="incoming_countdown_text">#B45309</color>
    <color name="incoming_status">#B91C1C</color>
    <color name="incoming_accept">#16A34A</color>
    <color name="incoming_reject">#DC2626</color>
    <color name="incoming_negotiate">#2563EB</color>
    <color name="incoming_card">#FFFFFF</color>
</resources>
