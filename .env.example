# Database
DATABASE_URL=postgresql+asyncpg://webtoapp:webtoapp@db:5432/webtoapp
DATABASE_URL_SYNC=postgresql://webtoapp:webtoapp@db:5432/webtoapp

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# App
APP_NAME=WebToApp
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
ENVIRONMENT=development
DEBUG=true

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@websitetoapp.app
SMTP_FROM_NAME=WebToApp

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GitLab CI/CD
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_ANDROID_PROJECT_ID=
GITLAB_DESKTOP_PROJECT_ID=

# GitHub Actions fallback (when GitLab CI quota is exceeded)
GITHUB_TOKEN=
GITHUB_REPO=pallavimokashi94-sys/webtoapp
GITHUB_TOKEN_2=
GITHUB_REPO_2=mokashiswapnil/webtoapp

# S3/R2 Storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=webtoapp
S3_REGION=auto
S3_PUBLIC_URL=

# Firebase
FIREBASE_CREDENTIALS_JSON=

# Sentry
SENTRY_DSN=

# Admin
ADMIN_EMAIL=admin@websitetoapp.app
ADMIN_PASSWORD=
