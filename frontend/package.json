{
  "name": "webtoapp-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node generate-static-pages.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:full": "npx playwright test full-e2e-with-apk.spec.ts --headed --timeout=1800000",
    "test:e2e:prod": "npx playwright test production-e2e.spec.ts --config=playwright.prod.config.ts",
    "test:android:setup": "npx ts-node e2e/setup/android-setup.ts",
    "test:android:create-avd": "npx ts-node e2e/setup/android-setup.ts --create-avd"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@react-oauth/google": "^0.13.4",
    "@tanstack/react-query": "^5.62.8",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
